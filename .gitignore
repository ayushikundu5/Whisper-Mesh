# Dependencies
node_modules/

# ---------------------------------------------------------------------------
# Generated native projects.
#
# `packages/app/android` and `ios` are produced by `npx expo prebuild` from
# app.json and the config plugins. They are 2.3 GB of build output here, they
# are regenerated by one command, and committing them means every future
# prebuild lands as an unreviewable diff. Anything meant to survive a prebuild
# belongs in app.json or in modules/whisper-ble, both of which are tracked.
# ---------------------------------------------------------------------------
packages/app/android/
packages/app/ios/

# Build output
build/
dist/
*.aab

# ---------------------------------------------------------------------------
# APKs are never committed. The release build is 112 MB and the debug build is
# 202 MB; GitHub rejects any file over 100 MB outright. Ship builds as Release
# assets, not as repository contents.
# ---------------------------------------------------------------------------
*.apk

# Native build caches
.cxx/
.gradle/
*.hprof
local.properties

# Expo
.expo/
.expo-shared/
web-build/

# Metro / bundler
.metro-health-check*
*.jsbundle

# Test and coverage
coverage/
*.lcov

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Editors and OS
.DS_Store
Thumbs.db
.idea/
*.iml
.vscode/*
!.vscode/extensions.json

# Secrets. Nothing here should ever exist, but an accidental keystore or signing
# config in a messenger repository is worth a hard rule rather than vigilance.
*.keystore
!packages/app/android/app/debug.keystore
*.jks
.env
.env.*
!.env.example
google-services.json

# Local assistant instructions. Not part of the published project.
CLAUDE.md
